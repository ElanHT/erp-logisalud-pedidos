# Supabase — proyecto compartido (schema "pedidos" para este módulo)
# Ver docs/architecture.md y docs/security.md antes de tocar estas variables.

# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key — segura para exponer en el navegador (protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOLO uso en servidor (Server Actions, Route Handlers).
# Nunca prefijar con NEXT_PUBLIC_. Nunca importar desde código de cliente.
SUPABASE_SERVICE_ROLE_KEY=


# Correo — notificación al enviar un pedido (Resend)
# Ver "Notificación por correo al enviar un pedido" en docs/architecture.md.
#
# Sin estas dos variables la app funciona igual: los pedidos se envían y
# el intento queda registrado como "fallido" en pedidos.notification_logs,
# pero no sale ningún correo. La pantalla
# /admin/configuracion/notificaciones avisa cuando falta configurarlas.

# API key del proyecto en Resend (https://resend.com/api-keys).
# Solo servidor — nunca prefijar con NEXT_PUBLIC_.
RESEND_API_KEY=

# Remitente de los correos. Debe estar sobre un dominio verificado en
# Resend (https://resend.com/domains); si no, Resend rechaza el envío.
# Ej: pedidos@logisalud.com — o "LOGISALUD Pedidos <pedidos@logisalud.com>"
RESEND_FROM_EMAIL=
